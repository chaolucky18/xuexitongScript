{
  "manifest_version": 3,
  "name": "学习通视频与测验助手",
  "version": "1.0.0",
  "description": "自动播放学习通课程视频，调用本机 DeepSeek 服务完成章节测验，并自动进入下一节。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:37841/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "学习通助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.chaoxing.com/mycourse/studentstudy*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://*.chaoxing.com/mycourse/studentstudy*"],
      "js": ["xuexitong-console.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}